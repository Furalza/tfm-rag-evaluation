    </node>
    <node id="Bridge Entities">
      <data key="d0">Bridge Entities</data>
      <data key="d1">concept</data>
      <data key="d2">Bridge entities are intermediate entities that aid in linking disparate pieces of evidence within complex queries.</data>
      <data key="d3">chunk-dbcf5df5b02a500f3b2ea2c8ec7025cd</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583182</data>
