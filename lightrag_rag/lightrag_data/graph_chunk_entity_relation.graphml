    </node>
    <node id="BGEC">
      <data key="d0">BGEC</data>
      <data key="d1">method</data>
      <data key="d2">BGEC stands for Bridge-Guided Evidence Calibration, which helps in identifying and promoting overlooked documents in the retrieval process.</data>
      <data key="d3">chunk-2c698ed84457a758cb717d3a15350b23&lt;SEP&gt;chunk-db856360bc385f7452666f475b3048d0&lt;SEP&gt;chunk-1cda1598277a8b2328ba59179c044b1e</data>
