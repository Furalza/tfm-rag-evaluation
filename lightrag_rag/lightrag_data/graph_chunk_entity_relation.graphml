    <node id="Chunking">
      <data key="d0">Chunking</data>
      <data key="d1">method</data>
      <data key="d2">Chunking is a technique used to break down large text corpora into smaller segments to improve information retrieval accuracy.</data>
      <data key="d3">chunk-c6d6d9678ee09aab0dfe417365eafee8</data>
      <data key="d4">unknown_source</data>
