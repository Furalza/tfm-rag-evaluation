    <node id="Baselines">
      <data key="d0">Baselines</data>
      <data key="d1">concept</data>
      <data key="d2">Baselines refer to the standard methods against which LightRAG's performance is compared, including Naive RAG and RQ-RAG.</data>
      <data key="d3">chunk-da2807be669ed8cdf9e947355ab6a13d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583314</data>
