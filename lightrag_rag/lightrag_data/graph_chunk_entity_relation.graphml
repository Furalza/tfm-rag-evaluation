    <node id="Key-Value Pair Generation">
      <data key="d0">Key-Value Pair Generation</data>
      <data key="d1">concept</data>
      <data key="d2">Key-Value Pair Generation involves creating pairs where the key is an entity name and the value summarizes relevant information for retrieval.</data>
      <data key="d3">chunk-267182096bcf7b04e9cc71c51a034340</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583298</data>
