    <node id="Deduplication">
      <data key="d0">Deduplication</data>
      <data key="d1">method</data>
      <data key="d2">Deduplication is a process that identifies and merges identical entities and relations from different segments of text to optimize graph operations.</data>
      <data key="d3">chunk-267182096bcf7b04e9cc71c51a034340</data>
      <data key="d4">unknown_source</data>
