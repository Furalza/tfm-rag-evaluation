    <node id="Knowledge Graph (KG)">
      <data key="d0">Knowledge Graph (KG)</data>
      <data key="d1">concept</data>
      <data key="d2">Knowledge Graph is a system that illustrates the relationships between different concepts and entities, facilitating information retrieval.</data>
      <data key="d3">chunk-6b568dd91e0d3a80a5dfbf3433e1123f</data>
      <data key="d4">unknown_source</data>
