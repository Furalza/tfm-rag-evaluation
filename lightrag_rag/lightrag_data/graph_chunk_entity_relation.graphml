      <data key="d6" />
    </node>
    <node id="Bridge Questions">
      <data key="d0">Bridge Questions</data>
      <data key="d1">concept</data>
      <data key="d2">Bridge questions are a specific type of question in multi-hop QA that require identifying intermediate entities to connect disjoint evidence.</data>
      <data key="d3">chunk-dbcf5df5b02a500f3b2ea2c8ec7025cd</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583182</data>
      <data key="d6" />
    </node>
    <node id="Question Type Analysis">
      <data key="d0">Question Type Analysis</data>
      <data key="d1">concept</data>
      <data key="d2">Question Type Analysis refers to the process of identifying which types of questions benefit most from iterative retrieval in multi-hop QA contexts.</data>
      <data key="d3">chunk-dbcf5df5b02a500f3b2ea2c8ec7025cd</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583182</data>
