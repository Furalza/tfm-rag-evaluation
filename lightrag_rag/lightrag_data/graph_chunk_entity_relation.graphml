    <node id="Embedding">
      <data key="d0">Embedding</data>
      <data key="d1">concept</data>
      <data key="d2">Embedding refers to the representation of documents in a vector space for storage in a vector database, facilitating knowledge retrieval.&lt;SEP&gt;Embedding refers to the representation of text in a vector space to facilitate similarity calculations in retrieval processes.</data>
      <data key="d3">chunk-1643acfc11b9ce83e842d06ad4bc4c3d&lt;SEP&gt;chunk-6b568dd91e0d3a80a5dfbf3433e1123f</data>
