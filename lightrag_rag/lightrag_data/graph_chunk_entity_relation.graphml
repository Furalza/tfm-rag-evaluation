    <node id="Indigenous Perspectives">
      <data key="d0">Indigenous Perspectives</data>
      <data key="d1">concept</data>
      <data key="d2">Indigenous Perspectives encompass community rights, collaboration, and cultural values that influence corporate mergers in certain countries.&lt;SEP&gt;Indigenous Perspectives encompass cultural significance and legal frameworks relating to ownership and collaboration within the context of corporate mergers.</data>
      <data key="d3">chunk-b4dab3d7bf1cd6f56a1ccda1dd029330&lt;SEP&gt;chunk-555fe0d2d7e01e7cf8692d28ba90ccc7</data>
