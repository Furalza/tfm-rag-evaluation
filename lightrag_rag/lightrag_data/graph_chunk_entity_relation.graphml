    </node>
    <node id="Exact Match (EM)">
      <data key="d0">Exact Match (EM)</data>
      <data key="d1">metric</data>
      <data key="d2">Exact Match (EM) is a metric that measures the percentage of predictions that exactly match ground-truth answers in QA evaluation.</data>
      <data key="d3">chunk-2a054701fac93a0f7901f4619ad32bdd</data>
      <data key="d4">unknown_source</data>
