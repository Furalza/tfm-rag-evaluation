    </node>
    <node id="Self-Memory">
      <data key="d0">Self-Memory</data>
      <data key="d1">concept</data>
      <data key="d2">Self-memory is a technique referenced in the context of retrieval-augmented text generation, emphasizing the importance of leveraging past information for generating text outputs.</data>
      <data key="d3">chunk-50fab934716e3d9351f065107bc18294</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583285</data>
      <data key="d6" />
    </node>
    <node id="FT">
      <data key="d0">FT</data>
      <data key="d1">concept</data>
      <data key="d2">FT is a method characterized by retraining a model over time, focusing on internalizing knowledge suitable for static scenarios.</data>
      <data key="d3">chunk-947ec822a759fcee4b9eb66e23cede0d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583285</data>
      <data key="d6" />
    </node>
    <node id="Knowledge Graph">
      <data key="d0">Knowledge Graph</data>
      <data key="d1">concept</data>
      <data key="d2">A Knowledge Graph is utilized within LightRAG to facilitate rapid and relevant document retrieval.&lt;SEP&gt;Knowledge Graph is a type of structured data source used for enhancing retrieval methods such as RAG.&lt;SEP&gt;A knowledge graph is a structured representation of information about entities, their attributes, and the relationships between them.</data>
      <data key="d3">chunk-947ec822a759fcee4b9eb66e23cede0d&lt;SEP&gt;chunk-0f24883bfa660df15d08e8b13fb36a4d&lt;SEP&gt;chunk-2166023ef5af5223914f65a3580aa066</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583286</data>
