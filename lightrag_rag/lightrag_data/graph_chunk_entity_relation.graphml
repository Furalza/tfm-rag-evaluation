    </node>
    <node id="Corporate Mergers">
      <data key="d0">Corporate Mergers</data>
      <data key="d1">event</data>
      <data key="d2">Corporate Mergers refer to the process of combining companies and are influenced by indigenous perspectives in countries such as Canada and Australia.</data>
      <data key="d3">chunk-b4dab3d7bf1cd6f56a1ccda1dd029330</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583108</data>
