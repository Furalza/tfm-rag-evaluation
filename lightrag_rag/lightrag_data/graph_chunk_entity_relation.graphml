    <node id="LLM Profiling">
      <data key="d0">LLM Profiling</data>
      <data key="d1">method</data>
      <data key="d2">LLM Profiling is a profiling function that utilizes large language models to generate text key-value pairs for entities and relationships.</data>
      <data key="d3">chunk-267182096bcf7b04e9cc71c51a034340</data>
