    <node id="Dual-Thought-Based Retrieval">
      <data key="d0">Dual-Thought-Based Retrieval</data>
      <data key="d1">method</data>
      <data key="d2">Dual-Thought-Based Retrieval is a method used to improve information retrieval by generating complementary thoughts and bridging evidence calibration.</data>
      <data key="d3">chunk-fd16cb2c8cbacbc8139b2f74a3aae2c0</data>
      <data key="d4">unknown_source</data>
