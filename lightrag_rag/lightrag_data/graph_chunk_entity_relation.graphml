    <node id="Data Structure">
      <data key="d0">Data Structure</data>
      <data key="d1">concept</data>
      <data key="d2">Data Structure refers to the organization of data that is utilized in retrieval processes, initially involving mainstream text and expanding to semi-structured and structured data.</data>
