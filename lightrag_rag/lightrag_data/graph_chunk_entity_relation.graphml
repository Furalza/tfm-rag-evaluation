    <node id="RAG Systems">
      <data key="d0">RAG Systems</data>
      <data key="d1">concept</data>
      <data key="d2">RAG systems are frameworks designed to provide tailored and up-to-date information while enhancing retrieval accuracy through chunking.</data>
      <data key="d3">chunk-c6d6d9678ee09aab0dfe417365eafee8</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583182</data>
