    <node id="Reverse HyDE">
      <data key="d0">Reverse HyDE</data>
      <data key="d1">method</data>
      <data key="d2">Reverse HyDE is a technique involving the generation of hypothetical questions using LLM to bridge gaps during the retrieval process.</data>
      <data key="d3">chunk-6b568dd91e0d3a80a5dfbf3433e1123f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583173</data>
