    <node id="BDTR Framework">
      <data key="d0">BDTR Framework</data>
      <data key="d1">concept</data>
      <data key="d2">The BDTR Framework is proposed for addressing multi-hop question answering (QA) through iterative retrieval techniques.</data>
      <data key="d3">chunk-2c698ed84457a758cb717d3a15350b23</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583106</data>
