    <node id="RQ-RAG">
      <data key="d0">RQ-RAG</data>
      <data key="d1">method</data>
      <data key="d2">RQ-RAG is a method that uses an LLM to decompose input queries into multiple sub-queries to improve search accuracy.</data>
      <data key="d3">chunk-da2807be669ed8cdf9e947355ab6a13d</data>
      <data key="d4">unknown_source</data>
