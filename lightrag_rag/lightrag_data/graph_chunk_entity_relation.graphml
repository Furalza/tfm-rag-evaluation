      <data key="d6" />
    </node>
    <node id="PopQA">
      <data key="d0">PopQA</data>
      <data key="d1">dataset</data>
      <data key="d2">PopQA is a single-hop dataset used to examine the effectiveness of various retrieval strategies, sampling queries from Wikipedia.&lt;SEP&gt;PopQA is a dataset intended for evaluation in question answering, focusing on popular knowledge questions.</data>
      <data key="d3">chunk-2c698ed84457a758cb717d3a15350b23&lt;SEP&gt;chunk-f188543fb58390e379ea6d2f1dc2ef58</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583106</data>
      <data key="d6" />
    </node>
    <node id="HippoRAG">
      <data key="d0">HippoRAG</data>
      <data key="d1">concept</data>
      <data key="d2">HippoRAG stands for Hierarchical and Iterative Passage Retrieval with Attention Guidance, used as a reference framework in the study.&lt;SEP&gt;HippoRAG is a system that incorporates iterative retrieval methodologies into the Framework of GraphRAG.</data>
      <data key="d3">chunk-2c698ed84457a758cb717d3a15350b23&lt;SEP&gt;chunk-1a18be2a653ce076549457febaf41543&lt;SEP&gt;chunk-db856360bc385f7452666f475b3048d0</data>
