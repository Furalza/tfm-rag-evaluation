    <node id="Shanghai Key Laboratory of Data Science">
      <data key="d0">Shanghai Key Laboratory of Data Science</data>
      <data key="d1">organization</data>
      <data key="d2">The Shanghai Key Laboratory of Data Science is affiliated with the School of Computer Science at Fudan University and plays a role in data science research.</data>
      <data key="d3">chunk-555fe0d2d7e01e7cf8692d28ba90ccc7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583365</data>
      <data key="d6" />
    </node>
    <node id="Fudan University">
      <data key="d0">Fudan University</data>
      <data key="d1">organization</data>
      <data key="d2">Fudan University is a prominent university located in Shanghai, known for its research and education in various fields, including computer science.</data>
      <data key="d3">chunk-555fe0d2d7e01e7cf8692d28ba90ccc7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583365</data>
      <data key="d6" />
    </node>
    <node id="RAG Frameworks">
      <data key="d0">RAG Frameworks</data>
      <data key="d1">concept</data>
      <data key="d2">RAG Frameworks consist of various models and methods like Naive RAG, Advanced RAG, and Modular RAG that work together to enhance the retrieval and generation processes in large language models.</data>
      <data key="d3">chunk-555fe0d2d7e01e7cf8692d28ba90ccc7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583365</data>
      <data key="d6" />
    </node>
    <node id="Answer 1 (TagRAG)">
      <data key="d0">Answer 1 (TagRAG)</data>
      <data key="d1">content</data>
      <data key="d2">Answer 1 (TagRAG) offers a comprehensive explanation of feature selection techniques and is noted as the overall winner in evaluations.</data>
      <data key="d3">chunk-1d996179ca03cd750046549600e440a2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583365</data>
      <data key="d6" />
    </node>
    <node id="Validation Techniques">
      <data key="d0">Validation Techniques</data>
      <data key="d1">concept</data>
      <data key="d2">Validation techniques assess the impact of feature selection on model performance, ensuring selected features meaningfully contribute to predictive power.</data>
      <data key="d3">chunk-1d996179ca03cd750046549600e440a2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583365</data>
      <data key="d6" />
    </node>
    <node id="Computational Resources">
      <data key="d0">Computational Resources</data>
      <data key="d1">concept</data>
      <data key="d2">Computational resources refer to the hardware and software resources needed to execute feature selection techniques efficiently.&lt;SEP&gt;Computational Resources are the available processing power and memory that affect the feasibility of using certain feature selection techniques.</data>
      <data key="d3">chunk-1d996179ca03cd750046549600e440a2&lt;SEP&gt;chunk-ffda1de83dfb7a5a6814e4849f7c189e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583366</data>
      <data key="d6" />
    </node>
    <node id="Domain Knowledge">
      <data key="d0">Domain Knowledge</data>
      <data key="d1">concept</data>
      <data key="d2">Domain knowledge is the understanding of the subject area that can influence feature selection choices and outcomes.&lt;SEP&gt;Domain Knowledge is an important consideration in feature selection as it helps inform which features may be most relevant to the problem being addressed.</data>
      <data key="d3">chunk-1d996179ca03cd750046549600e440a2&lt;SEP&gt;chunk-ffda1de83dfb7a5a6814e4849f7c189e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583366</data>
      <data key="d6" />
    </node>
    <node id="Model Type">
      <data key="d0">Model Type</data>
      <data key="d1">concept</data>
      <data key="d2">Model type refers to the specific algorithm or technique employed in machine learning, which affects the choice of feature selection method.&lt;SEP&gt;Model Type refers to the specific algorithms or methodologies used in modeling, which can dictate the appropriateness of different feature selection techniques.</data>
      <data key="d3">chunk-1d996179ca03cd750046549600e440a2&lt;SEP&gt;chunk-ffda1de83dfb7a5a6814e4849f7c189e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583366</data>
      <data key="d6" />
    </node>
    <node id="TagTAG">
      <data key="d0">TagTAG</data>
      <data key="d1">organization</data>
      <data key="d2">TagTAG is the name of an organization involved in the comparison of feature selection techniques, alongside GraphRAG.&lt;SEP&gt;TagTAG is a feature selection technique that was evaluated against GraphRAG, and it provides various methods for selecting important features in machine learning.</data>
      <data key="d3">chunk-1d996179ca03cd750046549600e440a2&lt;SEP&gt;chunk-e0143589fd55955961c410246d286aaa</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583366</data>
      <data key="d6" />
    </node>
    <node id="Sparse Retrieval Models">
      <data key="d0">Sparse Retrieval Models</data>
      <data key="d1">concept</data>
      <data key="d2">Sparse Retrieval Models are algorithms designed to capture relevance features in search queries and can enhance the performance of dense retrieval models.</data>
      <data key="d3">chunk-269f5e6f28821bf79c7854694a47f38e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583366</data>
      <data key="d6" />
    </node>
    <node id="Dense Retrieval Models">
      <data key="d0">Dense Retrieval Models</data>
      <data key="d1">concept</data>
      <data key="d2">Dense Retrieval Models are advanced algorithms that improve the effectiveness of search results by learning from large datasets.</data>
      <data key="d3">chunk-269f5e6f28821bf79c7854694a47f38e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583366</data>
      <data key="d6" />
    </node>
    <node id="Pre-Training Language Models">
      <data key="d0">Pre-Training Language Models</data>
      <data key="d1">concept</data>
      <data key="d2">Pre-Training Language Models (PLMs) are models pre-trained on vast amounts of text, used to improve various natural language processing tasks.</data>
      <data key="d3">chunk-269f5e6f28821bf79c7854694a47f38e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583367</data>
      <data key="d6" />
    </node>
    <node id="LSR (LM-Supervised Retriever)">
      <data key="d0">LSR (LM-Supervised Retriever)</data>
      <data key="d1">method</data>
      <data key="d2">LSR is a method that employs results from language models to supervise the fine-tuning process of retrieval algorithms.</data>
      <data key="d3">chunk-269f5e6f28821bf79c7854694a47f38e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583367</data>
      <data key="d6" />
    </node>
    <node id="PROMPTAGATOR">
      <data key="d0">PROMPTAGATOR</data>
      <data key="d1">method</data>
      <data key="d2">PROMPTAGATOR utilizes language models as query generators for creating task-specific retrievers in supervised learning environments.</data>
      <data key="d3">chunk-269f5e6f28821bf79c7854694a47f38e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583367</data>
      <data key="d6" />
    </node>
    <node id="LLM-Embedder">
      <data key="d0">LLM-Embedder</data>
      <data key="d1">method</data>
      <data key="d2">LLM-Embedder exploits language models to produce reward signals for optimizing downstream tasks in machine learning.</data>
      <data key="d3">chunk-269f5e6f28821bf79c7854694a47f38e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583367</data>
      <data key="d6" />
    </node>
    <node id="REPLUG">
      <data key="d0">REPLUG</data>
      <data key="d1">method</data>
      <data key="d2">REPLUG integrates a retriever and a language model to compute probability distributions and enhance supervised training processes.</data>
      <data key="d3">chunk-269f5e6f28821bf79c7854694a47f38e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583367</data>
      <data key="d6" />
    </node>
    <node id="Adapter">
      <data key="d0">Adapter</data>
      <data key="d1">concept</data>
      <data key="d2">Adapter refers to an external component incorporated into models to facilitate alignment and integrate additional functionalities.</data>
      <data key="d3">chunk-269f5e6f28821bf79c7854694a47f38e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583367</data>
      <data key="d6" />
    </node>
    <node id="UPRISE">
      <data key="d0">UPRISE</data>
      <data key="d1">method</data>
      <data key="d2">UPRISE is a method that trains a lightweight prompt retriever for automatic retrieval suitable for zero-shot tasks.</data>
      <data key="d3">chunk-269f5e6f28821bf79c7854694a47f38e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583368</data>
      <data key="d6" />
    </node>
    <node id="AAR (Augmentation-Adapted Retriever)">
      <data key="d0">AAR (Augmentation-Adapted Retriever)</data>
      <data key="d1">method</data>
      <data key="d2">AAR is a universal adapter designed to support multiple downstream tasks in retrieval systems.</data>
      <data key="d3">chunk-269f5e6f28821bf79c7854694a47f38e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583368</data>
      <data key="d6" />
    </node>
    <node id="Context Curation">
      <data key="d0">Context Curation</data>
      <data key="d1">concept</data>
      <data key="d2">Context Curation involves refining and adjusting retrieved content before it is input to the language model for question answering.</data>
      <data key="d3">chunk-269f5e6f28821bf79c7854694a47f38e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583368</data>
      <data key="d6" />
    </node>
    <node id="Reranking">
      <data key="d0">Reranking</data>
      <data key="d1">method</data>
      <data key="d2">Reranking is a method that reorders document chunks to prioritize the most relevant results and reduce irrelevant information.</data>
      <data key="d3">chunk-269f5e6f28821bf79c7854694a47f38e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583368</data>
      <data key="d6" />
    </node>
    <node id="Context Selection/Compression">
      <data key="d0">Context Selection/Compression</data>
      <data key="d1">method</data>
      <data key="d2">Context Selection/Compression is a technique that optimizes the amount of retrieved information to improve the quality of input passed to a language model.</data>
      <data key="d3">chunk-269f5e6f28821bf79c7854694a47f38e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583368</data>
      <data key="d6" />
    </node>
    <node id="BGM">
      <data key="d0">BGM</data>
      <data key="d1">method</data>
      <data key="d2">BGM is a method that maintains the retriever and language model fixed while training a bridge Seq2Seq model to process retrieved information.</data>
      <data key="d3">chunk-269f5e6f28821bf79c7854694a47f38e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583368</data>
      <data key="d6" />
    </node>
    <node id="Information Extraction">
      <data key="d0">Information Extraction</data>
      <data key="d1">method</data>
      <data key="d2">Information Extraction is a downstream task of RAG focused on retrieving specific information from texts.&lt;SEP&gt;Information Extraction (IE) refers to the process of automatically extracting structured information from unstructured data.</data>
      <data key="d3">chunk-f188543fb58390e379ea6d2f1dc2ef58&lt;SEP&gt;chunk-ad7c3af766c81fe98ee471c948a2b726</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583369</data>
      <data key="d6" />
    </node>
    <node id="EM Score">
      <data key="d0">EM Score</data>
      <data key="d1">metric</data>
      <data key="d2">The EM (Exact Match) score is a metric used in evaluation to measure the accuracy of generated answers against reference answers.</data>
      <data key="d3">chunk-f188543fb58390e379ea6d2f1dc2ef58</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583369</data>
      <data key="d6" />
    </node>
    <node id="Accuracy">
      <data key="d0">Accuracy</data>
      <data key="d1">metric</data>
      <data key="d2">Accuracy is a metric that measures the proportion of true results in predictive analytics.</data>
      <data key="d3">chunk-f188543fb58390e379ea6d2f1dc2ef58</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583369</data>
      <data key="d6" />
    </node>
    <node id="BLEU">
      <data key="d0">BLEU</data>
      <data key="d1">metric</data>
      <data key="d2">BLEU (Bilingual Evaluation Understudy) is a metric used to evaluate the quality of text generated by comparing it to a set of references.</data>
      <data key="d3">chunk-f188543fb58390e379ea6d2f1dc2ef58</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583369</data>
      <data key="d6" />
    </node>
    <node id="ROUGE">
      <data key="d0">ROUGE</data>
      <data key="d1">metric</data>
      <data key="d2">ROUGE (Recall-Oriented Understudy for Gisting Evaluation) is a set of metrics used to evaluate automatic summarization and machine translation.</data>
      <data key="d3">chunk-f188543fb58390e379ea6d2f1dc2ef58</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583369</data>
      <data key="d6" />
    </node>
    <node id="RALLE">
      <data key="d0">RALLE</data>
      <data key="d1">tool</data>
      <data key="d2">RALLE is a tool designed for the automatic evaluation of Retrieval-Augmented Generation applications.</data>
      <data key="d3">chunk-f188543fb58390e379ea6d2f1dc2ef58</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583369</data>
      <data key="d6" />
    </node>
    <node id="Hit Rate">
      <data key="d0">Hit Rate</data>
      <data key="d1">metric</data>
      <data key="d2">Hit Rate is a metric that measures the frequency at which relevant documents are retrieved in information retrieval systems.</data>
      <data key="d3">chunk-f188543fb58390e379ea6d2f1dc2ef58</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583370</data>
      <data key="d6" />
    </node>
    <node id="MRR">
      <data key="d0">MRR</data>
      <data key="d1">metric</data>
      <data key="d2">MRR (Mean Reciprocal Rank) is a statistical measure used to evaluate the effectiveness of systems that return a list of ordered items, like search engines.</data>
      <data key="d3">chunk-f188543fb58390e379ea6d2f1dc2ef58</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583370</data>
      <data key="d6" />
    </node>
    <node id="NDCG">
      <data key="d0">NDCG</data>
      <data key="d1">metric</data>
      <data key="d2">NDCG (Normalized Discounted Cumulative Gain) is a metric used to measure the effectiveness of search engines based on the rank positions of relevant documents.</data>
      <data key="d3">chunk-f188543fb58390e379ea6d2f1dc2ef58</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583370</data>
      <data key="d6" />
    </node>
    <node id="QA">
      <data key="d0">QA</data>
      <data key="d1">event</data>
      <data key="d2">QA (Question Answering) refers to a task in which systems seek to provide answers to questions based on a text corpus or knowledge base.</data>
      <data key="d3">chunk-f188543fb58390e379ea6d2f1dc2ef58</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583370</data>
      <data key="d6" />
    </node>
    <node id="Natural Question (NQ)">
      <data key="d0">Natural Question (NQ)</data>
      <data key="d1">dataset</data>
      <data key="d2">Natural Question (NQ) is a dataset used for evaluating question answering systems through single-hop questions.</data>
      <data key="d3">chunk-f188543fb58390e379ea6d2f1dc2ef58</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583371</data>
      <data key="d6" />
    </node>
    <node id="TriviaQA (TQA)">
      <data key="d0">TriviaQA (TQA)</data>
      <data key="d1">dataset</data>
      <data key="d2">TriviaQA is a dataset designed for the task of question answering, aimed at assessing system performance on trivia-related questions.</data>
      <data key="d3">chunk-f188543fb58390e379ea6d2f1dc2ef58</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583371</data>
      <data key="d6" />
    </node>
    <node id="Web Questions (WebQ)">
      <data key="d0">Web Questions (WebQ)</data>
      <data key="d1">dataset</data>
      <data key="d2">Web Questions is a dataset for evaluating question-answering models based on web search queries.</data>
      <data key="d3">chunk-f188543fb58390e379ea6d2f1dc2ef58</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583371</data>
      <data key="d6" />
    </node>
    <node id="MS MARCO">
      <data key="d0">MS MARCO</data>
      <data key="d1">dataset</data>
      <data key="d2">MS MARCO (Microsoft MAchine Reading COmprehension) is a large-scale dataset designed for training and evaluating machine reading comprehension models.</data>
      <data key="d3">chunk-f188543fb58390e379ea6d2f1dc2ef58</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583371</data>
      <data key="d6" />
    </node>
    <node id="ELI5">
      <data key="d0">ELI5</data>
      <data key="d1">dataset</data>
      <data key="d2">ELI5 (Explain Like I'm Five) is a long-form question answering dataset aimed at providing comprehensive answers to complex questions.</data>
      <data key="d3">chunk-f188543fb58390e379ea6d2f1dc2ef58</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583371</data>
      <data key="d6" />
    </node>
    <node id="Retrieval Quality">
      <data key="d0">Retrieval Quality</data>
      <data key="d1">concept</data>
      <data key="d2">Retrieval Quality refers to the evaluation of the effectiveness of context sourced by the retriever component in RAG models.</data>
      <data key="d3">chunk-f188543fb58390e379ea6d2f1dc2ef58</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583371</data>
      <data key="d6" />
    </node>
    <node id="Generation Quality">
      <data key="d0">Generation Quality</data>
      <data key="d1">concept</data>
      <data key="d2">Generation Quality pertains to the assessment of a model's ability to create coherent and relevant answers based on retrieved context.</data>
      <data key="d3">chunk-f188543fb58390e379ea6d2f1dc2ef58</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583371</data>
      <data key="d6" />
    </node>
    <node id="Noise Robustness">
      <data key="d0">Noise Robustness</data>
      <data key="d1">concept</data>
      <data key="d2">Noise Robustness is an ability of the RAG model to manage documents that are related to questions but contain little substantive information.</data>
      <data key="d3">chunk-f188543fb58390e379ea6d2f1dc2ef58</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583372</data>
      <data key="d6" />
    </node>
    <node id="Negative Rejection">
      <data key="d0">Negative Rejection</data>
      <data key="d1">concept</data>
      <data key="d2">Negative Rejection is the ability of the RAG model to refrain from responding when retrieved documents lack the necessary knowledge.</data>
      <data key="d3">chunk-f188543fb58390e379ea6d2f1dc2ef58</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583372</data>
      <data key="d6" />
    </node>
    <node id="Information Integration">
      <data key="d0">Information Integration</data>
      <data key="d1">concept</data>
      <data key="d2">Information Integration evaluates the model's proficiency in synthesizing information from multiple documents to answer complex questions.</data>
      <data key="d3">chunk-f188543fb58390e379ea6d2f1dc2ef58</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583372</data>
      <data key="d6" />
    </node>
    <node id="Counterfactual Robustness">
      <data key="d0">Counterfactual Robustness</data>
      <data key="d1">concept</data>
      <data key="d2">Counterfactual Robustness tests the model’s capability to disregard inaccuracies found in the documents, even when directed about misinformation.</data>
      <data key="d3">chunk-f188543fb58390e379ea6d2f1dc2ef58</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583372</data>
      <data key="d6" />
    </node>
    <node id="Domain-Centric Knowledge Summaries">
      <data key="d0">Domain-Centric Knowledge Summaries</data>
      <data key="d1">concept</data>
      <data key="d2">Domain-centric knowledge summaries provide an efficient retrieval platform for specialized domain documents.</data>
      <data key="d3">chunk-0ea6794ce9d046650a5db1c76934db39</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583372</data>
      <data key="d6" />
    </node>
    <node id="RAG Paradigm">
      <data key="d0">RAG Paradigm</data>
      <data key="d1">concept</data>
      <data key="d2">The RAG paradigm refers to a framework for refining specialized domain documents for better access and knowledge extraction.</data>
      <data key="d3">chunk-0ea6794ce9d046650a5db1c76934db39</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583373</data>
      <data key="d6" />
    </node>
    <node id="Domain Tag Chain">
      <data key="d0">Domain Tag Chain</data>
      <data key="d1">concept</data>
      <data key="d2">A domain tag chain consists of extracted object tags managed hierarchically, providing a clear direction for domain knowledge graphs.</data>
      <data key="d3">chunk-0ea6794ce9d046650a5db1c76934db39</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583373</data>
      <data key="d6" />
    </node>
    <node id="Directed Acyclic Graph (DAG)">
      <data key="d0">Directed Acyclic Graph (DAG)</data>
      <data key="d1">concept</data>
