    <node id="Ablation Study">
      <data key="d0">Ablation Study</data>
      <data key="d1">event</data>
      <data key="d2">The Ablation Study evaluates the contributions of the components in the BDTR method, providing insights into performance improvements.</data>
      <data key="d3">chunk-fd16cb2c8cbacbc8139b2f74a3aae2c0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583221</data>
