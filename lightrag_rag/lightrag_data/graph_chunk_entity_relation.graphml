      <data key="d0">Beijing University of Posts and Telecommunications</data>
      <data key="d1">organization</data>
      <data key="d2">Beijing University of Posts and Telecommunications is the institution where some researchers of the LightRAG system are affiliated.</data>
      <data key="d3">chunk-84d742eb8f55bba51e586b51f2ebe7ed</data>
