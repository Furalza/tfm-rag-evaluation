    <edge source="LightRAG Framework" target="LLMs">
      <data key="d7">1.0</data>
      <data key="d8">LLMs are utilized for the purposes described in the LightRAG framework.</data>
      <data key="d9">application</data>
      <data key="d10">chunk-a20fbc060c512f64ca1f33b81ac188d3</data>
