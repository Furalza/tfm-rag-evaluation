    <node id="Recall@K">
      <data key="d0">Recall@K</data>
      <data key="d1">concept</data>
      <data key="d2">Recall@K is a performance metric that evaluates the effectiveness of retrieval methods by checking if relevant documents appear within the leading positions.</data>
      <data key="d3">chunk-dbcf5df5b02a500f3b2ea2c8ec7025cd</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1780583182</data>
