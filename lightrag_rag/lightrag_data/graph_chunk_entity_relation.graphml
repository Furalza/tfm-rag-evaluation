    <node id="1.1h">
      <data key="d0">1.1h</data>
      <data key="d1">data</data>
      <data key="d2">1.1h indicates the running time for the IRCOT method as reported in the comparison of retrieval runtimes.</data>
      <data key="d3">chunk-fd16cb2c8cbacbc8139b2f74a3aae2c0</data>
      <data key="d4">unknown_source</data>
