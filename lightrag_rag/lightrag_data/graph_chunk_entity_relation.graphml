    <node id="Evaluation Criteria">
      <data key="d0">Evaluation Criteria</data>
      <data key="d1">concept</data>
      <data key="d2">Evaluation Criteria are measurable standards used to compare Answer 1 and Answer 2.&lt;SEP&gt;Evaluation criteria are the standards used to assess the effectiveness and comprehensiveness of feature selection techniques.</data>
      <data key="d3">chunk-fca82b44b4c7fd0632ad9bf69000d74e&lt;SEP&gt;chunk-e0143589fd55955961c410246d286aaa</data>
